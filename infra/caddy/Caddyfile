# ft_trascendence — Caddy: the only container that publishes ports.
#
# Inside the container Caddy always listens on 80 / 443 / 3443; compose maps
# them to CADDY_HTTP_PORT / CADDY_HTTPS_PORT / GRAFANA_HOST_PORT on the host.
#
# TLS: CADDY_TLS=internal (default) signs a certificate for CADDY_DOMAIN with
# Caddy's own CA — works for localhost, a LAN hostname or an IP. Set CADDY_TLS
# to an e-mail address to get a Let's Encrypt certificate for a real domain.

{
	# We publish non-standard host ports, so the redirect is written by hand
	# below and HTTP/3 (UDP is not published) is not advertised.
	auto_https disable_redirects
	# Names show up as the `server` label of Caddy's Prometheus metrics.
	servers :443 {
		name app
		protocols h1 h2
	}
	servers :3443 {
		name grafana
		protocols h1 h2
	}
	servers :80 {
		name redirect
	}
	servers :9180 {
		name internal
	}
	metrics
}

(common) {
	tls {$CADDY_TLS}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# HSTS is keyed by host name only, so sending it for "localhost" would
	# also force HTTPS on every other local dev server (Vite on :5173).
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"
}

# ─── HTTP → HTTPS (the published HTTPS port is not 443) ────
http://:80 {
	redir https://{host}:{$CADDY_HTTPS_PORT}{uri}
}

# ─── Application ───────────────────────────────────────────
https://{$CADDY_DOMAIN}:443 {
	import common
	header X-Frame-Options SAMEORIGIN
	# Only our own origin runs code. Styles and fonts also come from Google Fonts;
	# lesson videos and images may live on any HTTPS host; blob: covers the
	# previews of files picked before upload. Grafana keeps its own policy.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

	handle /health {
		reverse_proxy backend:3000
	}

	# Nest has no global prefix: strip /api (same as the Vite dev proxy).
	handle_path /api* {
		reverse_proxy backend:3000
	}

	# Socket.io — reverse_proxy handles the WebSocket upgrade by itself.
	handle /socket.io* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:8080
	}
}

# ─── Grafana (own origin; Prometheus is not exposed) ───
https://{$CADDY_DOMAIN}:3443 {
	import common
	reverse_proxy grafana:3000
}

# ─── Internal listener, compose network only (never published) ───
http://:9180 {
	respond /healthz "ok"
	metrics /metrics
}
