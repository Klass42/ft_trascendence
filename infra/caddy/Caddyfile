# ft_trascendence — Caddy reverse proxy
# All listen ports, upstreams, and the public domain come from .env.example
# (injected as container env; Caddy expands {$VAR}).
#
# TLS:
#   - "localhost": internal CA (self-signed)
#   - real domain: Let's Encrypt (needs port 80 reachable from the internet)

# HTTP → HTTPS redirect (include HTTPS port — campus is not on :443)
http://:{$CADDY_HTTP_PORT} {
	redir {$APP_URL}{uri}
}

# ─── Application ──────────────────────────────────────────
{$CADDY_DOMAIN}:{$CADDY_HTTPS_PORT} {
	handle /health {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT}
	}

	# Strip /api prefix — Nest has no global prefix (matches Vite + nginx).
	handle_path /api* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT}
	}

	# Socket.io (Epic E) — WebSocket upgrade is automatic in reverse_proxy.
	handle /socket.io* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT}
	}

	# Local development uploads; production S3 returns a presigned external URL.
	handle /uploads* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT}
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT}
	}
}

# ─── Monitoring (HTTPS, same domain, dedicated host ports) ─
{$CADDY_DOMAIN}:{$GRAFANA_HOST_PORT} {
	reverse_proxy {$GRAFANA_HOST}:{$GRAFANA_PORT}
}

{$CADDY_DOMAIN}:{$PROMETHEUS_HOST_PORT} {
	reverse_proxy {$PROMETHEUS_HOST}:{$PROMETHEUS_PORT}
}

{$CADDY_DOMAIN}:{$TEMPO_HOST_PORT} {
	reverse_proxy {$TEMPO_HOST}:{$TEMPO_PORT}
}

{$CADDY_DOMAIN}:{$LOKI_HOST_PORT} {
	reverse_proxy {$LOKI_HOST}:{$LOKI_PORT}
}
