# ============================================================================
#  ft_trascendence — single source of truth for compose / Makefile / Caddy
# ============================================================================
#  Committed contract. Copy to .env (gitignored) and change only what you need:
#
#    cp infra/docker/.env.example infra/docker/.env
#    # or:  make env
#
#  Imported by:
#    docker compose --env-file infra/docker/.env.example -f infra/docker/docker-compose.yml
#    make  (always passes --env-file; optional .env overlays, last file wins)
#    Caddy  (env_file on the caddy service → {$VAR} in Caddyfile)
#    Vite   (loadEnv from this directory — FRONTEND_DEV_PORT / BACKEND_PORT)
#
#  Do NOT put real production secrets here. Dev placeholders only.
#  Internal docker-network hostnames stay as compose service names.
#  Host-published ports are unprivileged 41xx/4443 (80/443 need root on campus).
# ============================================================================

# ─── Project ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ft-trascendence
NODE_ENV=production
DEPLOY_ENVIRONMENT=production

# ─── caddy ─────────────────────────────────────────────────
CADDY_IMAGE=caddy:2-alpine
CADDY_DOMAIN=localhost
CADDY_HTTP_PORT=4180
CADDY_HTTPS_PORT=4443
APP_URL=https://${CADDY_DOMAIN}:${CADDY_HTTPS_PORT}

# ─── frontend ──────────────────────────────────────────────
FRONTEND_IMAGE=apps/frontend/Dockerfile
FRONTEND_HOST=frontend
FRONTEND_PORT=5173
FRONTEND_DEV_PORT=5173
FRONTEND_URL=https://${CADDY_DOMAIN}:${CADDY_HTTPS_PORT}
VITE_BACKEND_URL=/api

# ─── backend ───────────────────────────────────────────────
BACKEND_IMAGE=apps/backend/Dockerfile
BACKEND_HOST=backend
BACKEND_PORT=3000
BACKEND_HEALTH_URL=http://${BACKEND_HOST}:${BACKEND_PORT}/health
BACKEND_HEALTH_INTERVAL=10s
BACKEND_HEALTH_TIMEOUT=5s
BACKEND_HEALTH_RETRIES=5
JWT_ACCESS_SECRET=dev-not-secret-replace-me
JWT_REFRESH_SECRET=dev-not-secret-replace-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://${CADDY_DOMAIN}:${CADDY_HTTPS_PORT}/auth/google/callback
OTEL_SERVICE_NAME=ft-backend

# ─── postgres ──────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft_prod
POSTGRES_HEALTH_INTERVAL=5s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=10

# ─── grafana ───────────────────────────────────────────────
GRAFANA_IMAGE=grafana/grafana:11.4.0
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_HOST_PORT=4150
GRAFANA_URL=https://${CADDY_DOMAIN}:${GRAFANA_HOST_PORT}
GRAFANA_PROMETHEUS_URL=http://${PROMETHEUS_HOST}:${PROMETHEUS_PORT}
GRAFANA_TEMPO_URL=http://${TEMPO_HOST}:${TEMPO_PORT}
GRAFANA_LOKI_URL=http://${LOKI_HOST}:${LOKI_PORT}
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_FEATURE_TOGGLES_ENABLE=traceQLStreaming,metricsSummary
GF_INSTALL_PLUGINS=

# ─── Initial platform superadmin ───────────────────────────
# Optional. When PLATFORM_SUPERADMIN_EMAIL is set, backend startup creates an
# organization-less SUPERADMIN exactly once. The password is never reset later.
# Sign in at /platform/login; this route does not ask for an organization code.
PLATFORM_SUPERADMIN_EMAIL=admin@platform.local
PLATFORM_SUPERADMIN_PASSWORD=ChangeMe123
PLATFORM_SUPERADMIN_NAME=Platform Administrator

# ─── prometheus ────────────────────────────────────────────
PROMETHEUS_IMAGE=prom/prometheus:v2.54.0
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_HOST_PORT=4160
PROMETHEUS_URL=https://${CADDY_DOMAIN}:${PROMETHEUS_HOST_PORT}
PROMETHEUS_REMOTE_WRITE_URL=http://${PROMETHEUS_HOST}:${PROMETHEUS_PORT}/api/v1/write
PROMETHEUS_RETENTION=7d
PROMETHEUS_SCRAPE_INTERVAL=15s

# ─── tempo ─────────────────────────────────────────────────
TEMPO_IMAGE=grafana/tempo:2.6.1
TEMPO_HOST=tempo
TEMPO_PORT=3200
TEMPO_HOST_PORT=4161
TEMPO_URL=https://${CADDY_DOMAIN}:${TEMPO_HOST_PORT}
TEMPO_OTLP_ENDPOINT=${TEMPO_HOST}:${OTEL_GRPC_PORT}

# ─── loki ──────────────────────────────────────────────────
LOKI_IMAGE=grafana/loki:3.3.2
LOKI_HOST=loki
LOKI_PORT=3100
LOKI_HOST_PORT=4165
LOKI_URL=https://${CADDY_DOMAIN}:${LOKI_HOST_PORT}
LOKI_OTLP_ENDPOINT=http://${LOKI_HOST}:${LOKI_PORT}/otlp

# ─── otel-collector ────────────────────────────────────────
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.114.0
OTEL_COLLECTOR_HOST=otel-collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8888
OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_HTTP_PORT}
OTEL_BATCH_TIMEOUT=5s
OTEL_BATCH_SIZE=1024
OTEL_MEMORY_LIMIT_MIB=512
OTEL_MEMORY_SPIKE_MIB=128

# ─── garage / s3 ───────────────────────────────────────────
# Local storage is the self-contained default. Set STORAGE_DRIVER=s3 only
# together with a reachable S3/Garage endpoint and valid credentials.
STORAGE_DRIVER=local
S3_HOST=garage
S3_PORT=3900
S3_ENDPOINT=http://${S3_HOST}:${S3_PORT}
S3_REGION=garage
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=ft-uploads

# ─── nix-portable ──────────────────────────────────────────
NIX_PORTABLE_VERSION=v012
NIX_PORTABLE_BASE_URL=https://github.com/DavHau/nix-portable/releases/download
