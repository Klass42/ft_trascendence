# ============================================================================
#  Optional LOCAL overrides (gitignored as infra/docker/.env)
# ============================================================================
#  Canonical defaults live in params.env — compose always imports that file.
#  Copy this (or params.env) to .env and uncomment only what you change:
#
#    cp infra/docker/.env.example infra/docker/.env
#    # or:  make env
#
#  Later --env-file wins, so values here overlay params.env.
# ============================================================================

# COMPOSE_PROJECT_NAME=ft-trascendence
# CADDY_DOMAIN=localhost
# APP_URL=https://localhost:4443
# FRONTEND_URL=https://localhost:4443

# CADDY_HTTP_PORT=4180
# CADDY_HTTPS_PORT=4443
# GRAFANA_HOST_PORT=4150
# PROMETHEUS_HOST_PORT=4160
# TEMPO_HOST_PORT=4161
# LOKI_HOST_PORT=4165

# POSTGRES_USER=ft
# POSTGRES_PASSWORD=ft
# POSTGRES_DB=ft_prod

# JWT_ACCESS_SECRET=change-me
# JWT_REFRESH_SECRET=change-me

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://localhost:4443/auth/google/callback

# S3_ENDPOINT=http://garage:3900
# S3_REGION=garage
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_BUCKET=ft-uploads

# VITE_BACKEND_URL=/api

# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
