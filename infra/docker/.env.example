# ============================================================================
#  ft_trascendence — environment configuration
#  Copy to .env and adjust values:  cp infra/docker/.env.example infra/docker/.env
#  .env is git-ignored. This file is committed (no secrets).
#
#  The compose file uses inline defaults, so it works WITHOUT an .env file
#  for local testing. Override here for real deployments.
# ============================================================================

# ─── General ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ft-trascendence

# ─── Caddy / HTTPS ─────────────────────────────────────────
# Use "localhost" for local eval (self-signed cert).
# Use a real domain for production (Let's Encrypt auto-managed).
CADDY_DOMAIN=localhost

# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft_prod

# ─── Auth (JWT) ────────────────────────────────────────────
# Dev defaults included in compose. Replace for staging/prod.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ─── Initial platform superadmin ───────────────────────────
# Optional. When PLATFORM_SUPERADMIN_EMAIL is set, backend startup creates an
# organization-less SUPERADMIN exactly once. The password is never reset later.
# Sign in at /platform/login; this route does not ask for an organization code.
PLATFORM_SUPERADMIN_EMAIL=admin@platform.local
PLATFORM_SUPERADMIN_PASSWORD=ChangeMe123
PLATFORM_SUPERADMIN_NAME=Platform Administrator

# ─── Auth (Google OAuth) ───────────────────────────────────
# Empty = Google auth disabled. Set real values for staging/prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost/auth/google/callback

# ─── Frontend URL (CORS / OAuth redirect) ─────────────────
FRONTEND_URL=https://localhost

# ─── Object storage (Garage / S3) ─────────────────────────
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=ft-uploads

# ─── Frontend build ───────────────────────────────────────
# Vite build arg → nginx proxies /api/ → backend:3000 internally
VITE_BACKEND_URL=/api

# ─── Grafana ───────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
