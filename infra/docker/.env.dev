# Development environment variables
NODE_ENV=development
COMPOSE_PROJECT_NAME=ft-trascendence-dev

# Backend
BACKEND_PORT=3000
OTEL_SERVICE_NAME=ft-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Database (dev defaults — matches the postgres service in docker-compose.dev.yml)
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft_dev
DATABASE_URL=postgresql://ft:ft@postgres:5432/ft_dev?schema=public

# Frontend
VITE_BACKEND_URL=http://localhost:3000

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=7d
