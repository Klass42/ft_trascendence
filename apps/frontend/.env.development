# Development-only environment variables
# These are NOT committed to production

# =============================================================================
# Mock Auth (for UI development before real auth exists)
# =============================================================================
# Set to "true" to use a fake user and bypass auth completely.
# This allows seeing the full UI without a working backend.
# Remove or set to "false" when real auth is ready.
VITE_USE_MOCK_AUTH=true

# =============================================================================
# Dev Auth (for testing with real backend but no login)
# =============================================================================
# userId from seed to use for API calls before real auth exists
# This maps to the x-dev-user header that Jorge's DevAuthGuard reads
# Get valid IDs from: pnpm prisma db seed (after running make db-seed)
# Example IDs (update after running seed):
#   - admin@demo: cuid-from-seed-admin
#   - teacher@demo: cuid-from-seed-teacher  
#   - student@demo: cuid-from-seed-student
VITE_DEV_USER_ID=
