# Development-only environment variables
# These are NOT committed to production

# Dev auth: userId from seed to use for API calls before real auth exists
# This maps to the x-dev-user header that Jorge's DevAuthGuard reads
# Get valid IDs from: pnpm prisma db seed (after running make db-seed)
# Example IDs (update after running seed):
#   - admin@demo: cuid-from-seed-admin
#   - teacher@demo: cuid-from-seed-teacher  
#   - student@demo: cuid-from-seed-student
VITE_DEV_USER_ID=
