// ============================================================================
//  ft_trascendence — LMS · Prisma schema (MVP phase)
// ----------------------------------------------------------------------------
//  Conventions (see AGENTS.md §5):
//   - English identifiers only.
//   - `organizationId` scopes tenant data. Isolation is enforced in the APP
//     layer (Nest guards/services), NOT Postgres RLS. Every tenant-scoped query
//     MUST filter by organizationId (directly, or via its parent Subject/Course).
//   - A Course is a cohort (level + group + academic year). A Subject is one
//     taught offering of that cohort. Subject.organizationId must equal
//     Course.organizationId (enforced in the service).
//   - Binary content lives in object storage (Garage/S3); `File` holds only the
//     reference (bucket + objectKey). No blobs in the DB.
//
//  DEFERRED to Phase 2 (do NOT add until the feature is in scope):
//   billing (plans/subscriptions/payments), attendance, certificates, calendar
//   events, full quiz/exam engine, tutor–guardian relations,
//   nested course categories, per-tenant subdomains, RLS policies.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  Tenancy
// ============================================================================

/// The tenant. Maps to the "Organization system" module (create/read/update/delete,
/// add/remove members). NOT a SaaS institution with billing/subdomains (Phase 2).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in URLs; not a subdomain
  logoUrl   String?
  status OrganizationStatus @default(ACTIVE)
  primaryColor String?
  defaultLanguage String @default("es")
  timezone String @default("Europe/Madrid")
  // SUPERADMIN-configurable plan/limits (issue #18). `null` on a limit means
  // "unlimited"; enforcing it (e.g. blocking sign-ups past maxUsers) is the
  // owning feature's job (users/courses/files) — this model only stores it.
  plan OrganizationPlan @default(STARTER)
  maxUsers Int?
  maxCourses Int?
  maxStorageMb Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  courses  Course[]
  subjects Subject[]
  files    File[]
  learningResources LearningResource[]
  resourceFolders   ResourceFolder[]
  invitations OrganizationInvitation[]
  auditLogs AuditLog[]
  taskTemplates TaskTemplate[]
}

// ============================================================================
//  Users, auth & social
// ============================================================================

model User {
  id              String       @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  passwordHash    String? // null when the account is OAuth-only
  name            String
  avatarUrl       String?
  bio             String?
  role            GlobalRole   @default(STUDENT)
  platformRole    PlatformRole @default(NONE)
  onlineAt        DateTime? // updated on activity; drives online status
  emailVerifiedAt DateTime?
  deactivatedAt   DateTime? // #134: removed from the org (no login), history kept; null = active
  emailNotificationsEnabled Boolean  @default(true)
  preferredLanguage         String   @default("es")
  createdAt                 DateTime @default(now())
  updatedAt       DateTime     @updatedAt

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  courseMemberships CourseMembership[]
  subjectStaff      SubjectStaff[]
  submissions       Submission[]       @relation("SubmissionAuthor")
  gradedSubmissions Submission[]       @relation("SubmissionGrader")
  attempts          Attempt[]          @relation("AttemptUser")
  gradedAttempts    Attempt[]          @relation("AttemptGrader")
  forumThreads      ForumThread[]
  forumPosts        ForumPost[]
  notifications     Notification[]
  uploadedFiles     File[]             @relation("FileUploader")
  createdLearningResources LearningResource[] @relation("LearningResourceCreator")
  createdResourceFolders   ResourceFolder[]   @relation("ResourceFolderCreator")
  lessonCompletions LessonCompletion[]
  friendsInitiated  Friendship[]       @relation("FriendRequester")
  friendsReceived   Friendship[]       @relation("FriendAddressee")
  invitationsSent  OrganizationInvitation[] @relation("InvitationInviter")
  auditLogs        AuditLog[] @relation("AuditActor")
  taskTemplates    TaskTemplate[] @relation("TaskTemplateAuthor")

  // Email is unique WITHIN an organization (tenant-scoped), not globally.
  @@unique([organizationId, email])
  @@index([organizationId])
}

model OrganizationInvitation {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email String
  role GlobalRole
  tokenHash String @unique
  status InvitationStatus @default(PENDING)
  expiresAt DateTime
  acceptedAt DateTime?
  invitedById String?
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action String
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  targetUserId String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique // store the hash, never the raw token
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

/// OAuth 2.0 linked accounts (Google for the MVP).
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // 'google'
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// ============================================================================
//  Files (references to object storage)
// ============================================================================

model File {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploaderId     String?
  uploader       User?        @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  bucket         String
  objectKey      String
  originalName   String
  contentType    String?
  sizeBytes      BigInt       @default(0)
  createdAt      DateTime     @default(now())

  lessonAttachments LessonAttachment[]
  submissionFiles   SubmissionFile[]
  assignmentFiles   AssignmentFile[]
  activityFiles     ActivityFile[]
  learningResources LearningResource[] @relation("LearningResourceFile")

  @@unique([bucket, objectKey])
  @@index([organizationId])
}

// ============================================================================
//  Cohorts, subjects & content
// ============================================================================

/// Academic cohort: level + group + year (e.g. name `1º A`, academicYear `2025-2026`).
model Course {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  academicYear   String
  startsOn       DateTime
  endsOn         DateTime
  status         CohortStatus @default(PLANNED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subjects    Subject[]
  memberships CourseMembership[]

  @@unique([organizationId, name, academicYear])
  @@index([organizationId])
}

/// One taught offering inside a single cohort. Not a reusable catalog:
/// the same title in two cohorts is two rows.
model Subject {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  category       String?
  imageUrl       String?
  status         PublicationStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sections     Section[]
  staff        SubjectStaff[]
  assignments  Assignment[]
  activities   Activity[]
  forumThreads ForumThread[]
  resources    SubjectResource[]
  folders      SubjectFolder[]

  @@index([organizationId])
  @@index([courseId])
}

/// Student membership in a cohort. A user may have at most one membership
/// whose course is ACTIVE inside their organization (enforced in the service;
/// Prisma cannot express a partial unique index). Archiving the course keeps
/// the row as history.
model CourseMembership {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model SubjectStaff {
  id        String           @id @default(cuid())
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SubjectStaffRole
  createdAt DateTime         @default(now())

  @@unique([subjectId, userId])
  @@index([userId])
}

model Section {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  lessons Lesson[]

  @@index([subjectId])
}

model Lesson {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  contentMd String? // rich text as markdown
  videoUrl  String? // embedded/external video
  order     Int      @default(0)
  createdAt DateTime @default(now())

  attachments LessonAttachment[]
  completions LessonCompletion[]

  @@index([sectionId])
}

model LessonAttachment {
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileId   String
  file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([lessonId, fileId])
  @@index([fileId])
}

model LessonCompletion {
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([lessonId, userId])
  @@index([userId])
}

// ============================================================================
//  Learning-resource library
// ============================================================================

/// Reusable academic material owned by an organization. The object bytes stay
/// in File/object storage; this model supplies catalog metadata and publication
/// to one or more courses. `fileId` XOR `externalUrl` is enforced by ResourcesService.
model LearningResource {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                   @relation("LearningResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title          String
  description    String?
  type           LearningResourceType
  authors        String[]               @default([])
  publisher      String?
  isbn           String?
  language       String?
  license        String?
  tags           String[]               @default([])
  fileId         String?
  file           File?                  @relation("LearningResourceFile", fields: [fileId], references: [id], onDelete: Restrict)
  externalUrl    String?
  status         LearningResourceStatus @default(DRAFT)
  publishedAt    DateTime?
  folderId       String?
  folder         ResourceFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  subjects SubjectResource[]

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([createdById])
  @@index([fileId])
  @@index([folderId])
}

/// A resource can be published once and reused by multiple subjects. It stays
/// subject-level; use LessonAttachment for material tied to a specific lesson.
/// Real library folder (#26). Deleting a folder moves its children to the root
/// (parentId/folderId -> null) and removes only the folder itself.
model ResourceFolder {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User             @relation("ResourceFolderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parentId       String?
  parent         ResourceFolder?  @relation("ResourceFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ResourceFolder[] @relation("ResourceFolderTree")
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  resources LearningResource[]
  subjects  SubjectFolder[]

  @@index([organizationId, parentId])
  @@index([createdById])
}

/// Live link between a folder and a subject (#26): every resource inside the
/// folder or any descendant folder, now or in the future, appears in the
/// subject's resource tab without being linked one by one.
model SubjectFolder {
  folderId  String
  folder    ResourceFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  required  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@id([folderId, subjectId])
  @@index([subjectId])
}

model SubjectResource {
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  order      Int              @default(0)
  required   Boolean          @default(false)

  @@id([resourceId, subjectId])
  @@index([subjectId, order])
}

// ============================================================================
//  Assignments, submissions & grading
// ============================================================================

model Assignment {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  openAt      DateTime? // submissions accepted from this moment (null = open now)
  dueAt       DateTime? // soft deadline; submissions after this are marked LATE
  closeAt     DateTime? // hard close; submissions rejected after this (null = never)
  maxScore    Float     @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions Submission[]
  files       AssignmentFile[] // teacher's prompt attachments

  @@index([subjectId])
}

/// Files a teacher attaches to an assignment (the prompt/resources), as opposed
/// to SubmissionFile (files a student hands in). Mirrors the SubmissionFile join.
model AssignmentFile {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([assignmentId, fileId])
  @@index([fileId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  text         String?
  status       SubmissionStatus @default(SUBMITTED)
  score        Float?
  feedback     String?
  gradedById   String?
  gradedBy     User?            @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  files SubmissionFile[]

  @@unique([assignmentId, userId])
  @@index([userId])
}

model SubmissionFile {
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([submissionId, fileId])
  @@index([fileId])
}

// ============================================================================
//  Forums
// ============================================================================

model ForumThread {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  posts ForumPost[]

  @@index([subjectId])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  String? // for nested replies
  parent    ForumPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumPost[] @relation("PostReplies")
  body      String
  createdAt DateTime    @default(now())

  @@index([threadId])
  @@index([parentId])
}

// ============================================================================
//  Notifications
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

// ============================================================================
//  Enums
// ============================================================================

enum GlobalRole {
  ADMIN
  TEACHER
  STUDENT
}

enum PlatformRole {
  NONE
  SUPERADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationPlan {
  STARTER
  GROWTH
  ENTERPRISE
  CUSTOM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CohortStatus {
  PLANNED
  ACTIVE
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubjectStaffRole {
  TEACHER
  ASSISTANT
}

enum LearningResourceType {
  BOOK
  DOCUMENT
  LINK
  VIDEO
  AUDIO
}

enum LearningResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
}

enum NotificationType {
  NEW_ASSIGNMENT
  ACTIVITY_PUBLISHED
  ACTIVITY_CHANGED
  ACTIVITY_REMOVED
  SUBMISSION_RECEIVED
  COURSE_CHANGED
  COURSE_CONTENT_CHANGED
  MEMBERSHIP_CHANGED
  FORUM_THREAD
  RESOURCE_CHANGED
  USER_CHANGED
  ORGANIZATION_CHANGED
  GRADE_PUBLISHED
  FORUM_REPLY
  ENROLLMENT
  DEADLINE_REMINDER
  FRIEND_REQUEST
  SYSTEM
}

// ─── Activity engine (B1) ─────────────────────────────────
// Rich, auto-gradable activities. Additive to Assignment/Submission, which stay
// as the MANUAL activity type. See docs/planning/David-B1-design.md.

model Activity {
  id              String            @id @default(cuid())
  subjectId       String
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type            ActivityType @default(QUIZ)
  title           String
  description     String?
  openAt          DateTime? // submissions accepted from this moment (null = open now)
  dueAt           DateTime? // soft deadline (attempts after are LATE — informational)
  closeAt         DateTime? // hard close; attempts rejected after (null = never)
  maxScore        Float        @default(100)
  attemptsAllowed Int          @default(1) // 0 = unlimited
  timeLimitSec    Int? // null = untimed
  config            Json         @default("{}") // { shuffleQuestions, shuffleOptions, showSolutions } (DTO-validated)
  status            PublicationStatus @default(DRAFT) // DRAFT / PUBLISHED / ARCHIVED
  countsTowardFinal Boolean      @default(true)
  templateId        String? // TaskTemplate.id of origin; no live FK (the recipe can be deleted)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  questions Question[]
  attempts  Attempt[]
  files     ActivityFile[]

  @@index([subjectId])
}

model Question {
  id         String       @id @default(cuid())
  activityId String
  activity   Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  kind       QuestionKind
  prompt     String
  points     Float        @default(1)
  order      Int          @default(0)
  content    Json // shape depends on `kind` (options/blanks/pairs/accepted…), DTO-validated
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  answers Answer[]

  @@index([activityId])
}

model Attempt {
  id          String        @id @default(cuid())
  activityId  String
  activity    Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("AttemptUser", fields: [userId], references: [id], onDelete: Cascade)
  attemptNo   Int           @default(1) // 1-based; enforced against attemptsAllowed
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Float? // scaled to the activity's maxScore
  gradedById  String?
  gradedBy    User?         @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt    DateTime?
  feedback    String?

  answers Answer[]

  @@unique([activityId, userId, attemptNo])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   Json // student's raw response, shape by kind
  correct    Boolean? // null = not auto-graded (subjective / pending manual)
  awarded    Float? // points awarded
  feedback   String? // teacher's per-question comment for the student
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([attemptId, questionId])
}

enum ActivityType {
  QUIZ // auto-gradable set of questions
  LISTENING // audio + questions (B4 media)
  SPEAKING // record audio → manual/AI grading (B4 media)
}

enum QuestionKind {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  ORDERING
  SHORT_ANSWER
  ESSAY
  FILE_UPLOAD
}

/// Reusable recipe (JSON snapshot of Question blocks). Instantiating copies
/// blocks onto a new Activity; deleting the template does not touch instances.
model TaskTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("TaskTemplateAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  title          String
  description    String?
  blocks         Json // TaskTemplateBlock[]
  createdFromId  String? // Activity.id of origin; no live FK (the activity may be archived)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([createdById])
}

/// Teacher prompt attachments on an Activity (not student FILE_UPLOAD answers).
model ActivityFile {
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([activityId, fileId])
  @@index([fileId])
}

enum AttemptStatus {
  IN_PROGRESS // started, not submitted
  SUBMITTED // submitted; objective auto-graded; awaiting manual (if any)
  GRADED // final score available
}
