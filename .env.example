# ============================================================================
#  ft_trascendence — example environment. Copy to `.env` and fill real values.
#  `.env` is git-ignored (see .gitignore). NEVER commit real secrets.
#  For the local docker dev stack, infra/docker/.env.dev already holds dev
#  defaults — this file documents what a real/staging deploy needs.
# ============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
POSTGRES_USER=ft
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ft_dev
DATABASE_URL=postgresql://ft:change-me@postgres:5432/ft_dev?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Google OAuth (User Management: OAuth module)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost/api/auth/google/callback

# --- Object storage (Garage / S3-compatible) ---
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=ft-uploads

# --- Frontend ---
VITE_BACKEND_URL=/api

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ft-backend
